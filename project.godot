[layer_names]

2d_physics/layer_1="walls"
2d_physics/layer_2="players"
2d_physics/layer_3="bullets"
2d_physics/layer_4="powerups"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
viewport/hdr_2d=true
anti_aliasing/quality/msaa_3d=2
scaling_3d/mode=2
scaling_3d/fsr_sharpness=0.8
environment/defaults/default_clear_color=Color(0.02745098, 0.02745098, 0.05882353, 1)
scaling_3d/mode.web=0
