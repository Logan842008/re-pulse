[gd_scene format=3]

[ext_resource type="Script" path="res://script/game.gd" id="1_game"]
[ext_resource type="PackedScene" path="res://scene/map.tscn" id="2_map"]
[ext_resource type="PackedScene" path="res://scene/hud.tscn" id="3_hud"]

[sub_resource type="Environment" id="Environment_glow"]
background_mode = 3
glow_enabled = true
glow_levels/1 = 1.0
glow_levels/2 = 1.0
glow_levels/3 = 1.0
glow_levels/4 = 0.5
glow_levels/5 = 0.0
glow_levels/6 = 0.0
glow_levels/7 = 0.0
glow_intensity = 1.0
glow_strength = 1.0
glow_blend_mode = 0
glow_hdr_threshold = 1.0

[node name="Game" type="Node2D"]
script = ExtResource("1_game")

[node name="GlowEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_glow")

[node name="Map" parent="." instance=ExtResource("2_map")]

[node name="Powerups" type="Node2D" parent="."]

[node name="Players" type="Node2D" parent="."]

[node name="Bullets" type="Node2D" parent="."]

[node name="PlayerSpawner" type="MultiplayerSpawner" parent="."]
spawn_path = NodePath("../Players")

[node name="BulletSpawner" type="MultiplayerSpawner" parent="."]
spawn_path = NodePath("../Bullets")

[node name="PowerupSpawner" type="MultiplayerSpawner" parent="."]
spawn_path = NodePath("../Powerups")

[node name="Camera2D" type="Camera2D" parent="."]

[node name="HUD" parent="." instance=ExtResource("3_hud")]
